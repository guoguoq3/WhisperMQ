    <!--
      Spring Boot 打包插件放在 pluginManagement 里：
      只有“可执行应用”模块（WhisperMQ-console）显式声明它才会 repackage 成可执行 jar；
      common/broker/producer/consumer 是库，保持普通 jar（否则 common 没有 main class 会构建失败，
      而且 fat jar 也无法被其他模块当作依赖使用）。
    -->
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
