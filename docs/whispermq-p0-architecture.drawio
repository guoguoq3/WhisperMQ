<mxfile host="app.diagrams.net" modified="2026-10-23T09:10:00.000Z" agent="dsh" version="24.7.17">
  <diagram id="p1" name="1-生产者与Broker-超时重传">
    <mxGraphModel dx="2200" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1_title" value="改造后：生产者 ↔ Broker 超时重传 ＆ 可靠投递（P0-A 连接保活 ＋ P0-B in-flight）" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="40" as="geometry" /></mxCell>
        <mxCell id="p1_lg0" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1340" y="30" width="22" height="14" as="geometry" /></mxCell>
        <mxCell id="p1_lg0t" value="未变" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1366" y="24" width="60" height="26" as="geometry" /></mxCell>
        <mxCell id="p1_lg1" value="" style="rounded=0;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1430" y="30" width="22" height="14" as="geometry" /></mxCell>
        <mxCell id="p1_lg1t" value="行为变更" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1456" y="24" width="80" height="26" as="geometry" /></mxCell>
        <mxCell id="p1_lg2" value="" style="rounded=0;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1560" y="30" width="22" height="14" as="geometry" /></mxCell>
        <mxCell id="p1_lg2t" value="新增" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1586" y="24" width="60" height="26" as="geometry" /></mxCell>
        <mxCell id="p1_lg3" value="" style="rounded=0;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1670" y="30" width="22" height="14" as="geometry" /></mxCell>
        <mxCell id="p1_lg3t" value="已删除 / 已修复的旧逻辑" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1696" y="24" width="200" height="26" as="geometry" /></mxCell>

        <mxCell id="p1_laneP" value="Producer（客户端）" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="300" height="30" as="geometry" /></mxCell>
        <mxCell id="p1_laneB" value="Broker" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="80" width="300" height="30" as="geometry" /></mxCell>
        <mxCell id="p1_laneC" value="Consumer（客户端）" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1600" y="80" width="300" height="30" as="geometry" /></mxCell>
        <mxCell id="p1_sep1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="120" as="sourcePoint" /><mxPoint x="640" y="1300" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1_sep2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1580" y="120" as="sourcePoint" /><mxPoint x="1580" y="1300" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="p1_P" value="P&lt;br&gt;生产者" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="380" y="240" width="120" height="70" as="geometry" /></mxCell>
        <mxCell id="p1_B" value="B&lt;br&gt;Broker" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="860" y="240" width="120" height="70" as="geometry" /></mxCell>
        <mxCell id="p1_C" value="Consumer" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1900" y="240" width="120" height="70" as="geometry" /></mxCell>

        <mxCell id="p1_e1" value="Message ＋ retryCount ＋ currentVersion" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_P" target="p1_B"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-6" /></mxGeometry></mxCell>
        <mxCell id="p1_e2" value="P_CONFIRM_MSG（落盘后立即回，≠ 消费成功）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_B" target="p1_P"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="6" /></mxGeometry></mxCell>
        <mxCell id="p1_e3" value="B_PUSH_MSG(messageId,json)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_B" target="p1_C"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-6" /></mxGeometry></mxCell>
        <mxCell id="p1_e4" value="C_ACK_MSG(ACK_SUCCESS / ACK_FAIL)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_C" target="p1_B"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="6" /></mxGeometry></mxCell>

        <mxCell id="p1_c1" value="traceIdLatchMap：key=traceId → VersionedLatch&lt;br&gt;每次尝试都新建 latch 并携带 currentVersion；迟到的旧版本确认不会误唤醒新的等待器（旧版靠覆盖 map 里的 latch，存在串扰）。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="300" height="110" as="geometry" /></mxCell>
        <mxCell id="p1_c2" value="生产者 ACK-MAP&lt;br&gt;ackConfirmHashMap：记录已确认消息（仅内存，排查用）。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="275" width="300" height="80" as="geometry" /></mxCell>
        <mxCell id="p1_c3" value="等待窗口：第 i 次重试等待 t = a·2^i&lt;br&gt;（a = producerRetryTimeCoefficient，默认 500ms）&lt;br&gt;共 1 次首发 ＋ 3 次重试 ≈ 7.5s" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="300" height="90" as="geometry" /></mxCell>
        <mxCell id="p1_c4" value="仍收不到 P_CONFIRM_MSG → 丢弃等待器，返回 Result(FAILED, 消息发送超时)；messageId 保留，可凭 ID 查 Broker 日志。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="240" y="940" width="340" height="80" as="geometry" /></mxCell>
        <mxCell id="p1_c5" value="心跳（新增）&lt;br&gt;写空闲 15s → HEARTBEAT_PING；Broker 回 HEARTBEAT_PONG。&lt;br&gt;Broker 读空闲 3×心跳周期（45s）关闭僵尸连接。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="40" y="1055" width="360" height="95" as="geometry" /></mxCell>
        <mxCell id="p1_c6" value="断线重连（新增）&lt;br&gt;closeFuture 监听 → 指数退避 1s/2s/4s…30s；&lt;br&gt;重连成功后消费者自动重新 joinGroup ＋ 按 subscriptionMap 重新订阅。&lt;br&gt;连接不可用时 send() 立即返回 FAILED（旧版 NPE 被 catch 吞掉）。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="40" y="1170" width="360" height="120" as="geometry" /></mxCell>

        <mxCell id="p1_tl" value="t = a·2^i" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;dashed=1;strokeColor=#666666;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="310" as="sourcePoint" /><mxPoint x="560" y="850" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1_r1" value="count=1（等待 500ms）" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="480" as="sourcePoint" /><mxPoint x="1190" y="480" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1_r2" value="count=2（1000ms）" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="590" as="sourcePoint" /><mxPoint x="1190" y="590" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1_r3" value="count=3（2000ms）" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="700" as="sourcePoint" /><mxPoint x="1190" y="700" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1_r4" value="count=4（4000ms，最后一次）" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="810" as="sourcePoint" /><mxPoint x="1190" y="810" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="p1_b1" value="messageMap：存储生产者发来的所有消息（可选持久化）＋ 消息日志；生产端超时重传沿用同一个 messageId。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1200" y="360" width="370" height="80" as="geometry" /></mxCell>
        <mxCell id="p1_b2" value="in-flight 表（新增，替换 consumerAckMap）&lt;br&gt;key = groupId|messageId&lt;br&gt;value = { consumerId, lastPushTime, attempts, message }&lt;br&gt;覆盖“已投递、未确认”窗口——旧版这段完全没有状态。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1200" y="455" width="370" height="140" as="geometry" /></mxCell>
        <mxCell id="p1_b3" value="投递前 containsKey 判重&lt;br&gt;生产端重传同一条消息时不再重复推送／重复投递（旧版判重 key 不一致，永远不命中）。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1200" y="610" width="370" height="90" as="geometry" /></mxCell>
        <mxCell id="p1_b4" value="ACK 超时扫描（每 ackTimeout/2 一次）&lt;br&gt;lastPushTime 超时 → redeliver：优先换一个消费者，attempts＋1；&lt;br&gt;attempts ＞ maxDeliveryAttempts(3) → 转死信。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1200" y="715" width="370" height="130" as="geometry" /></mxCell>
        <mxCell id="p1_b5" value="ACK 处理&lt;br&gt;ACK_SUCCESS → 移除 in-flight ＋ 位点前进&lt;br&gt;ACK_FAIL → 立即重投（旧版直接 return，消息静默消失）&lt;br&gt;消费者掉线 → onConsumerOffline 重投其未确认消息" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1200" y="860" width="370" height="140" as="geometry" /></mxCell>
        <mxCell id="p1_b6" value="consumerAckMap（已删除）&lt;br&gt;写入 key = topic|group，读取 key = messageId|consumerId&lt;br&gt;→ 判重永远不命中，且掩盖了“没有在途状态”的事实。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1200" y="1015" width="370" height="90" as="geometry" /></mxCell>
        <mxCell id="p1_b7" value="投递次数耗尽 → moveToDeadLetter&lt;br&gt;入死信队列 ＋ 落盘 ＋ 推进组位点 ＋ 清 in-flight；&lt;br&gt;死信可用 DEAD_LETTER_REPLAY 重放回原组。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1200" y="1120" width="370" height="140" as="geometry" /></mxCell>

        <mxCell id="p1_cc1" value="收到 B_PUSH_MSG → 调用业务监听器&lt;br&gt;成功 → ACK_SUCCESS；失败 → ACK_FAIL；&lt;br&gt;若监听器内已 reject()，则跳过 ACK_FAIL，避免“死信重试＋重投”双通道。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1600" y="360" width="560" height="120" as="geometry" /></mxCell>
        <mxCell id="p1_cc2" value="channelInactive 不再 close() 销毁 EventLoopGroup&lt;br&gt;（旧版一断线就失去重连能力）；重连由 closeFuture 统一触发。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1600" y="500" width="560" height="90" as="geometry" /></mxCell>
        <mxCell id="p1_cc3" value="重连成功后 onReconnected()&lt;br&gt;重新发 CONSUMER_JOIN_GROUP ＋ 逐个重发 GROUP_SUBSCRIBE&lt;br&gt;（Broker 用通道 ID 当 consumerId，重连就是新消费者，必须重新登记）" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1600" y="610" width="560" height="110" as="geometry" /></mxCell>

        <mxCell id="p1_sum" value="核心差异：旧版“推送即忘”（at-most-once，消费者崩了消息就卡死）→ 新版 in-flight ＋ 超时重投 ＋ 次数上限 ＋ 死信 ＋ 幂等（at-least-once）。Broker 收到消息并落盘就回 P_CONFIRM_MSG，但“业务是否消费成功”由 C_ACK_MSG 单独闭环。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1320" width="2120" height="90" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="p2" name="2-实体类层次">
    <mxGraphModel dx="1700" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2_title" value="改造后：消息实体层次（协议信封 / 功能层 DTO / 实际消息体 / Broker 内部状态）" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry" /></mxCell>
        <mxCell id="p2_lg0" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1180" y="30" width="22" height="14" as="geometry" /></mxCell>
        <mxCell id="p2_lg0t" value="未变" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1206" y="24" width="60" height="26" as="geometry" /></mxCell>
        <mxCell id="p2_lg2" value="" style="rounded=0;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1290" y="30" width="22" height="14" as="geometry" /></mxCell>
        <mxCell id="p2_lg2t" value="新增" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1316" y="24" width="60" height="26" as="geometry" /></mxCell>
        <mxCell id="p2_lg3" value="" style="rounded=0;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1400" y="30" width="22" height="14" as="geometry" /></mxCell>
        <mxCell id="p2_lg3t" value="旧的错误画法" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1426" y="24" width="140" height="26" as="geometry" /></mxCell>

        <mxCell id="p2_rpc" value="RpcMessageDTO（消息转发信封）&lt;br&gt;request：boolean　是否请求&lt;br&gt;methodType：String　方法类型&lt;br&gt;json：String　业务 DTO 的 JSON" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=13;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1150" y="360" width="420" height="150" as="geometry" /></mxCell>
        <mxCell id="p2_fn" value="FunctionEntity（功能层父类）&lt;br&gt;messageId：String　消息 ID（traceId）&lt;br&gt;json：String　业务内容&lt;br&gt;（所有功能层 DTO 都继承本类）" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=13;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="560" y="360" width="340" height="120" as="geometry" /></mxCell>
        <mxCell id="p2_comp" value="json 字段嵌套（组合，不是继承）" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#666666;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2_fn" target="p2_rpc"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="p2_e1" value="ErrorResponse&lt;br&gt;（methodType=ERROR 时承载原因）" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="200" height="90" as="geometry" /></mxCell>
        <mxCell id="p2_e2" value="ProducerMessageDTO&lt;br&gt;retryCount / currentVersion" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="290" y="150" width="230" height="90" as="geometry" /></mxCell>
        <mxCell id="p2_e3" value="PushMessageDTO&lt;br&gt;consumerGroup" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="550" y="150" width="220" height="90" as="geometry" /></mxCell>
        <mxCell id="p2_e4" value="ConsumerAckReqDTO&lt;br&gt;consumerId / ackStatus / groupId" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="800" y="150" width="230" height="90" as="geometry" /></mxCell>
        <mxCell id="p2_e5" value="ConsumerThings" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1060" y="150" width="200" height="90" as="geometry" /></mxCell>

        <mxCell id="p2_e6" value="SubscribeReqDTO&lt;br&gt;topic / tags / groupId" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="290" y="560" width="220" height="90" as="geometry" /></mxCell>
        <mxCell id="p2_e7" value="DeadLetterDTO&lt;br&gt;deadLetterId / deadType / deadTime / deadRetryCount" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="560" y="560" width="230" height="90" as="geometry" /></mxCell>
        <mxCell id="p2_e8" value="DeadLetterReplayReqDTO（新增）&lt;br&gt;deadLetterId" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="830" y="560" width="250" height="90" as="geometry" /></mxCell>

        <mxCell id="p2_i1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.08;entryY=0;" edge="1" parent="1" source="p2_e1" target="p2_fn"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2_i2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.28;entryY=0;" edge="1" parent="1" source="p2_e2" target="p2_fn"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2_i3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p2_e3" target="p2_fn"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2_i4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.72;entryY=0;" edge="1" parent="1" source="p2_e4" target="p2_fn"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2_i5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.92;entryY=0;" edge="1" parent="1" source="p2_e5" target="p2_fn"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2_i6" value="extend 继承" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.15;entryY=1;" edge="1" parent="1" source="p2_e6" target="p2_fn"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2_i7" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="p2_e7" target="p2_fn"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2_i8" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;exitX=0.5;exitY=0;entryX=0.85;entryY=1;" edge="1" parent="1" source="p2_e8" target="p2_fn"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="p2_msg" value="MqMessage（实际消息体）&lt;br&gt;topic / tag / payload / bizKey" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1160" y="620" width="300" height="110" as="geometry" /></mxCell>
        <mxCell id="p2_endure" value="MqMessageEnduring&lt;br&gt;enduring：boolean（默认 true）" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1160" y="780" width="300" height="90" as="geometry" /></mxCell>
        <mxCell id="p2_i9" value="extend" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="p2_endure" target="p2_msg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2_comp2" value="逐层 json 嵌套：Rpc.json → DTO.json → MqMessage" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#666666;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p2_rpc" target="p2_msg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2_fix" value="旧图错误：把 MqMessageEnduring 画成 FunctionEntity 的子类。实际是 MqMessage 的子类，只能作为 DTO.json 里的内容被嵌套。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1160" y="910" width="420" height="90" as="geometry" /></mxCell>
        <mxCell id="p2_inflight" value="InFlightMessage（新增，Broker 内部状态，不参与协议）&lt;br&gt;groupId / topic / messageId / message&lt;br&gt;consumerId / lastPushTime / attempts" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1160" y="1040" width="420" height="110" as="geometry" /></mxCell>

        <mxCell id="p2_mt" value="MethodType 常量（协议方法类型，共 14 个）&lt;br&gt;P_SEND_MSG　P_CONFIRM_MSG　B_PUSH_MSG　B_SUBSCRIBE_RESPONSE&lt;br&gt;C_ACK_MSG　C_DEAD_MSG　GROUP_SUBSCRIBE　GROUP_UNSUBSCRIBE&lt;br&gt;CONSUMER_JOIN_GROUP　CONSUMER_LEAVE_GROUP&lt;br&gt;★ HEARTBEAT_PING　★ HEARTBEAT_PONG（新增，心跳）&lt;br&gt;★ ERROR（新增，统一错误响应）&lt;br&gt;★ DEAD_LETTER_REPLAY（新增，死信重放）" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="700" height="230" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p3" name="3-死信队列">
    <mxGraphModel dx="1800" dy="1450" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p3_title" value="改造后：死信队列（拒绝 → 有界重试 → 终态入队 → 重启恢复 → 重放）" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="40" as="geometry" /></mxCell>
        <mxCell id="p3_lg0" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1150" y="30" width="22" height="14" as="geometry" /></mxCell>
        <mxCell id="p3_lg0t" value="未变" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1176" y="24" width="60" height="26" as="geometry" /></mxCell>
        <mxCell id="p3_lg1" value="" style="rounded=0;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1240" y="30" width="22" height="14" as="geometry" /></mxCell>
        <mxCell id="p3_lg1t" value="行为变更" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1266" y="24" width="80" height="26" as="geometry" /></mxCell>
        <mxCell id="p3_lg2" value="" style="rounded=0;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1360" y="30" width="22" height="14" as="geometry" /></mxCell>
        <mxCell id="p3_lg2t" value="新增" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1386" y="24" width="60" height="26" as="geometry" /></mxCell>
        <mxCell id="p3_lg3" value="" style="rounded=0;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1460" y="30" width="22" height="14" as="geometry" /></mxCell>
        <mxCell id="p3_lg3t" value="旧逻辑 / 旧缺陷" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1486" y="24" width="170" height="26" as="geometry" /></mxCell>

        <mxCell id="p3_scene" value="成为死信的三种场景&lt;br&gt;1. 业务主动拒绝且不重试：reject(deadType, retry=false)&lt;br&gt;2. 投递次数耗尽：ACK 超时 / ACK_FAIL / 消费者掉线，attempts ＞ maxDeliveryAttempts&lt;br&gt;3. 死信重试次数达到阈值：deadRetryCount ≥ maxDeadLetterRetryCount" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="380" height="220" as="geometry" /></mxCell>
        <mxCell id="p3_dto" value="DeadLetterDTO（死信实体）&lt;br&gt;deadLetterId：String　死信 ID（雪花）&lt;br&gt;deadType：DeadType　死信原因枚举&lt;br&gt;deadTime：LocalDateTime　产生时间&lt;br&gt;deadRetryCount：Integer　已重试次数（-1 = 不重试）&lt;br&gt;messageId：String　原消息 ID&lt;br&gt;json：String　PushMessageDTO（原组 groupId ＋ 原消息）" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="700" y="70" width="460" height="240" as="geometry" /></mxCell>

        <mxCell id="p3_laneB" value="Broker" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="340" width="200" height="30" as="geometry" /></mxCell>
        <mxCell id="p3_laneC" value="Consumer" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="340" width="200" height="30" as="geometry" /></mxCell>
        <mxCell id="p3_laneBiz" value="业务" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1300" y="340" width="200" height="30" as="geometry" /></mxCell>
        <mxCell id="p3_sep1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="380" as="sourcePoint" /><mxPoint x="660" y="1380" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p3_sep2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1250" y="380" as="sourcePoint" /><mxPoint x="1250" y="1380" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="p3_biz" value="业务处理失败&lt;br&gt;调用 reject(deadType, retry)" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1300" y="400" width="400" height="100" as="geometry" /></mxCell>
        <mxCell id="p3_wrap" value="封装 DeadLetterDTO&lt;br&gt;还原 PushMessageDTO（原消息 ＋ 原组 groupId）&lt;br&gt;不重试：deadRetryCount = -1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="700" y="400" width="480" height="110" as="geometry" /></mxCell>
        <mxCell id="p3_dec" value="是否重试？&lt;br&gt;重试：count ＋ 1&lt;br&gt;不重试：count = -1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="820" y="560" width="240" height="100" as="geometry" /></mxCell>
        <mxCell id="p3_rpc" value="发送 C_DEAD_MSG&lt;br&gt;RpcMessageDTO { methodType, json=DeadLetterDTO }" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="760" y="720" width="400" height="90" as="geometry" /></mxCell>

        <mxCell id="p3_bdec" value="Broker 判断重试次数&lt;br&gt;count == -1 或 count ≥ maxDeadLetterRetryCount ？" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="300" height="140" as="geometry" /></mxCell>
        <mxCell id="p3_bretry" value="重试：只回原组重投&lt;br&gt;（旧版调 handlerMessage 广播给所有订阅组，造成跨组重复消费）" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="300" height="120" as="geometry" /></mxCell>
        <mxCell id="p3_dlq" value="死信队列（内存 ＋ 文件）&lt;br&gt;入队条件：count = -1 或 count ≥ max" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="980" width="300" height="90" as="geometry" /></mxCell>

        <mxCell id="p3_normal" value="正常消息处理" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="760" y="880" width="420" height="90" as="geometry" /></mxCell>
        <mxCell id="p3_ok" value="是否成功处理？" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="820" y="1030" width="240" height="100" as="geometry" /></mxCell>
        <mxCell id="p3_success" value="成功&lt;br&gt;ACK_SUCCESS" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1110" y="1035" width="130" height="90" as="geometry" /></mxCell>

        <mxCell id="p3_dlqfix" value="DeadLetterQueue 改动（新增）&lt;br&gt;get() 空队列先判空（旧版 ConcurrentHashMap.get(null) → NPE）&lt;br&gt;removeById：原子摘除，并发重放只有一个成功&lt;br&gt;list() / size()：可查询积压" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1300" y="560" width="460" height="150" as="geometry" /></mxCell>
        <mxCell id="p3_replay" value="死信重放 API（新增）&lt;br&gt;DEAD_LETTER_REPLAY { deadLetterId }&lt;br&gt;→ removeById 原子摘除&lt;br&gt;→ 写 replayed-ids.log 标记&lt;br&gt;→ 重新投递回原组（isRetry=true，跳过位点判断）" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1300" y="730" width="460" height="160" as="geometry" /></mxCell>
        <mxCell id="p3_recover" value="启动恢复（修复）&lt;br&gt;recoverDeadLettersFromFile 旧版整段被注释掉；&lt;br&gt;按 split(竖线, 4) 解析，保留 payload 里的竖线；&lt;br&gt;跳过 replayed-ids.log 中的 ID；重复 ID 自动去重。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1300" y="910" width="460" height="150" as="geometry" /></mxCell>
        <mxCell id="p3_oldbug" value="旧缺陷（已修）&lt;br&gt;死信文件滚动时目录写成 /deadletter（少一个 s）→ 超过 10MB 后每条死信都写失败；&lt;br&gt;get() 空队列 NPE；恢复代码被注释。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1300" y="1080" width="460" height="130" as="geometry" /></mxCell>

        <mxCell id="p3_f1" value="reject(deadType, retry)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="p3_biz" target="p3_wrap"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
        <mxCell id="p3_f2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p3_wrap" target="p3_dec"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3_f3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p3_dec" target="p3_rpc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3_f4" value="C_DEAD_MSG" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="p3_rpc" target="p3_bdec"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3_f5" value="0 ≤ count ＜ max：重试" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p3_bdec" target="p3_bretry"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3_f6" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;entryX=1;entryY=0.5;" edge="1" parent="1" source="p3_bdec" target="p3_dlq"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="645" /><mxPoint x="400" y="1025" /></Array></mxGeometry></mxCell>
        <mxCell id="p3_f7" value="只回原组重投" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p3_bretry" target="p3_normal"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3_f8" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p3_normal" target="p3_ok"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3_f9" value="成功" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p3_ok" target="p3_success"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3_f10" value="失败再次 reject" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p3_ok" target="p3_wrap"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="1080" /><mxPoint x="680" y="455" /></Array></mxGeometry></mxCell>

        <mxCell id="p3_sum" value="闭环：拒绝 →（有界重试，只回原组）→ 终态入队 → 落盘 → 重启恢复 → 查询 → 重放 → 写重放标记（重启不再加载）。死信不再“只进不出”，也不会因为死信卡住位点导致每次重订阅都从头回溯。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1360" width="1720" height="60" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="p4" name="4-消费者位点">
    <mxGraphModel dx="2000" dy="1350" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1350" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p4_title" value="改造后：消费者位点（初始化 · 写入 · 刷盘策略）" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry" /></mxCell>
        <mxCell id="p4_lg0" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1150" y="30" width="22" height="14" as="geometry" /></mxCell>
        <mxCell id="p4_lg0t" value="未变" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1176" y="24" width="60" height="26" as="geometry" /></mxCell>
        <mxCell id="p4_lg1" value="" style="rounded=0;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1240" y="30" width="22" height="14" as="geometry" /></mxCell>
        <mxCell id="p4_lg1t" value="行为变更" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1266" y="24" width="80" height="26" as="geometry" /></mxCell>
        <mxCell id="p4_lg2" value="" style="rounded=0;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1360" y="30" width="22" height="14" as="geometry" /></mxCell>
        <mxCell id="p4_lg2t" value="新增" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1386" y="24" width="60" height="26" as="geometry" /></mxCell>
        <mxCell id="p4_lg3" value="" style="rounded=0;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1460" y="30" width="22" height="14" as="geometry" /></mxCell>
        <mxCell id="p4_lg3t" value="旧逻辑 / 旧缺陷" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1486" y="24" width="170" height="26" as="geometry" /></mxCell>

        <mxCell id="p4_scene" value="业务场景&lt;br&gt;1. 断点续传：消费者意外故障未能 ACK 就停止后，重启能精确找到上次消费的最后一条继续消费&lt;br&gt;2. 与死信队列联动：处理失败不推进位点，重试耗尽后才入死信并推进位点（新增）&lt;br&gt;3. 位点只在 ACK_SUCCESS 时前进，且只能单调前进" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="560" height="150" as="geometry" /></mxCell>

        <mxCell id="p4_laneA" value="位点初始化（订阅时）" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="320" height="30" as="geometry" /></mxCell>
        <mxCell id="p4_g" value="消费者组" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="310" width="180" height="70" as="geometry" /></mxCell>
        <mxCell id="p4_b" value="broker" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="180" height="70" as="geometry" /></mxCell>
        <mxCell id="p4_init" value="OffsetPersistUtil.init&lt;br&gt;复用已打开的 writer（旧版每订阅一个 topic 重开一次 → 句柄泄漏 ＋ 缓冲位点丢失）" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="60" y="570" width="340" height="130" as="geometry" /></mxCell>
        <mxCell id="p4_recover" value="recoverOffsetByGroupAndTopic&lt;br&gt;读 组ID-offset.log，取该 topic 最后一条位点" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="740" width="340" height="110" as="geometry" /></mxCell>
        <mxCell id="p4_map" value="topicOffsetMap（组内共享）&lt;br&gt;key = topic，value = 最新消息 ID" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="890" width="340" height="90" as="geometry" /></mxCell>
        <mxCell id="p4_replay" value="回溯位点之后的消息&lt;br&gt;新组默认 earliest（可配 new-group-start-from-earliest）&lt;br&gt;tag 匹配修正：订阅 [*] 也能回溯&lt;br&gt;按消息 ID 升序回溯（旧版 ConcurrentHashMap 遍历乱序）" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="60" y="1020" width="340" height="150" as="geometry" /></mxCell>

        <mxCell id="p4_laneB" value="位点写入（ACK 时）" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="270" width="320" height="30" as="geometry" /></mxCell>
        <mxCell id="p4_ack" value="消费者 ACK_SUCCESS" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="640" y="310" width="380" height="70" as="geometry" /></mxCell>
        <mxCell id="p4_update" value="updateGroupOffset&lt;br&gt;仅当新消息 ID 更大才更新（单调）" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="640" y="430" width="380" height="100" as="geometry" /></mxCell>
        <mxCell id="p4_write" value="writeMessage（新增：单线程队列）&lt;br&gt;writeExecutor（FIFO）串行执行，保证提交顺序即落盘顺序" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="640" y="580" width="380" height="110" as="geometry" /></mxCell>
        <mxCell id="p4_do" value="doWriteMessage&lt;br&gt;① 单调校验：≤ 已缓存位点直接丢弃&lt;br&gt;② 按组加锁&lt;br&gt;③ 超 10MB 滚动文件&lt;br&gt;④ 写入 ＋ flush（低频）/ 仅缓冲（高频）" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="640" y="740" width="380" height="170" as="geometry" /></mxCell>
        <mxCell id="p4_old" value="旧实现（已替换）&lt;br&gt;CompletableFuture.runAsync(commonPool) 多线程写同一个 BufferedWriter，且 write 无锁 → 行交叉 / 顺序颠倒 → 重启取最后一行 → 位点回退 → 重复消费" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="640" y="950" width="380" height="140" as="geometry" /></mxCell>
        <mxCell id="p4_close" value="closeGroup 只在“组销毁”时调用&lt;br&gt;旧版退订一个 topic 就关闭整组 writer，同组其他 topic 位点从此静默写不进去&lt;br&gt;关闭时先 flush 再 close（FIFO 排队，不阻塞 IO 线程）" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="640" y="1120" width="380" height="110" as="geometry" /></mxCell>

        <mxCell id="p4_sched" value="ScheduledExecutorService&lt;br&gt;定时任务线程池（守护线程）" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1100" y="310" width="360" height="90" as="geometry" /></mxCell>
        <mxCell id="p4_atomic" value="AtomicLong writeCount&lt;br&gt;统计窗口内写入量" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1100" y="430" width="360" height="80" as="geometry" /></mxCell>
        <mxCell id="p4_future" value="ScheduledFuture&lt;br&gt;scheduleAtFixedRate 的返回值&lt;br&gt;用于判断 flush 任务是否在运行、以及 cancel" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1100" y="540" width="360" height="110" as="geometry" /></mxCell>
        <mxCell id="p4_monitor" value="monitorWriteCount（窗口 windowSizeMillis = 10s）&lt;br&gt;取走 writeCount 并与 flushThreshold（100）比较" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1100" y="680" width="360" height="110" as="geometry" /></mxCell>
        <mxCell id="p4_dec" value="≥ flushThreshold ？" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1520" y="680" width="200" height="110" as="geometry" /></mxCell>
        <mxCell id="p4_start" value="startFlushTask&lt;br&gt;高频：定时批量 flush" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1480" y="840" width="260" height="90" as="geometry" /></mxCell>
        <mxCell id="p4_stop" value="stopFlushTask&lt;br&gt;低频：一条一刷" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1770" y="840" width="190" height="90" as="geometry" /></mxCell>
        <mxCell id="p4_batch" value="batchFlush&lt;br&gt;按组加锁 flush，每 flushIntervalMillis 一次" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1480" y="980" width="300" height="90" as="geometry" /></mxCell>
        <mxCell id="p4_note" value="小点&lt;br&gt;· 两层定时：写窗口监控（10s）＋ flush 周期（10s）&lt;br&gt;· 高频批量、低频逐条，避免“小流量也频繁刷盘”&lt;br&gt;· isFlushTaskRunning 防止重复提交定时任务&lt;br&gt;· 关闭时先 shutdown 等队列落完再关 writer（新增）" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1100" y="830" width="340" height="220" as="geometry" /></mxCell>

        <mxCell id="p4_a1" value="GROUP_SUBSCRIBE" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4_g" target="p4_b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4_a2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1" source="p4_b" target="p4_init"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4_a3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1" source="p4_init" target="p4_recover"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4_a4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1" source="p4_recover" target="p4_map"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4_a5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1" source="p4_map" target="p4_replay"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4_a6" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1" source="p4_ack" target="p4_update"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4_a7" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1" source="p4_update" target="p4_write"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4_a8" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1" source="p4_write" target="p4_do"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4_a9" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1" source="p4_monitor" target="p4_dec"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4_a10" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4_dec" target="p4_start"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4_a11" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4_dec" target="p4_stop"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4_a12" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1" source="p4_start" target="p4_batch"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="p4_sum" value="旧 3 个问题 → 新 3 个保证：① commonPool 异步写（乱序）→ 单线程 FIFO；② 无锁写同一 writer → 每组锁 ＋ 单调校验；③ 每次订阅重开 writer / 退订误关整组 → writer 复用 ＋ 只在组销毁时关闭。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="1270" width="1920" height="60" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
